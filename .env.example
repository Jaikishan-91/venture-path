# Copy to .env for local development. Never commit .env.

# Docker Compose (local development only)
POSTGRES_USER=venturepath
POSTGRES_PASSWORD=venturepath
POSTGRES_DB=venturepath
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# App
DATABASE_URL=postgresql://venturepath:venturepath@localhost:5432/venturepath
LOG_LEVEL=info
# Leave empty to log to stdout only.
LOKI_URL=http://localhost:3100

# Auth (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Local email via Mailpit (web UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=VenturePath <no-reply@venturepath.local>
# Google sign-in: leave both empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used by npm run db:seed to create the admin account.
ADMIN_EMAIL=admin@venturepath.local
ADMIN_PASSWORD=
