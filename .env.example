# Copy to .env for local development. Never commit .env.

# Docker Compose (local development only)
POSTGRES_USER=venturepath
POSTGRES_PASSWORD=venturepath
POSTGRES_DB=venturepath
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# App
DATABASE_URL=postgresql://venturepath:venturepath@localhost:5432/venturepath
LOG_LEVEL=info
# Leave empty to log to stdout only.
LOKI_URL=http://localhost:3100

# Auth (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Email. Defaults send everything to Mailpit (web UI: http://localhost:8025).
# For real email with Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (or 465),
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<Google App Password>, EMAIL_FROM=VenturePath <you@gmail.com>.
# Outside production, addresses on .local/.test/.example/.invalid always go to MAIL_CATCHER_URL.
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional: true for implicit TLS. Defaults to true on port 465, otherwise STARTTLS is required when logging in.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_CATCHER_URL=smtp://localhost:1025
EMAIL_FROM=VenturePath <no-reply@venturepath.local>
# Google sign-in: leave both empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LLM provider for AI features (resume analysis, JD generation).
# provider=disabled (default): no LLM calls, analysis stays unavailable.
# provider=openai: LLM_BASE_URL + LLM_API_KEY + LLM_MODEL required.
#   Example OpenAI:     base https://api.openai.com/v1, model gpt-4o-mini
#   Example Ollama:     base http://localhost:11434/v1, model llama3.1:8b (no key)
#   Example Gemini:     base https://generativelanguage.googleapis.com/v1beta/openai, model gemini-2.0-flash
#   Example Gemini via Google Cloud: use the Google Cloud endpoint with your API key.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
# Used by npm run db:seed to create the admin account.
ADMIN_EMAIL=admin@venturepath.local
ADMIN_PASSWORD=
