generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth models follow Better Auth's core schema (generated with `npx auth@1.7.6 generate`).

enum Role {
  user
  organisation
  admin
  /// Employee of one organisation, invited by email (ADR-036). Written only by `acceptInvite`.
  hiring_manager
}

model User {
  id                  String                @id
  name                String
  email               String
  emailVerified       Boolean               @default(false)
  image               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  /// Null until the user picks a role. Written only by application code, never by auth API input.
  role                Role?
  sessions            Session[]
  accounts            Account[]
  userProfile         UserProfile?
  organisationProfile OrganisationProfile?  @relation("OrganisationOwner")
  organisationReviews OrganisationProfile[] @relation("OrganisationReviewer")
  updatedPrompts      Prompt[]              @relation("PromptUpdatedBy")
  /// Set when this account is a hiring manager of an organisation.
  organisationMember  OrganisationMember?
  stageEvents         StageEvent[]
  challengeDecisions  ChallengeSubmission[] @relation("ChallengeDecidedBy")
  offersMade          Application[]         @relation("ApplicationOfferedBy")
  createdEvents       ScheduledEvent[]      @relation("ScheduledEventCreatedBy")
  interviewerOf       EventInterviewer[]
  interviewFeedback   InterviewFeedback[]

  @@unique([email])
  @@map("user")
}

enum OrganisationStatus {
  pending
  approved
  rejected
}

model UserProfile {
  id                   String                @id @default(uuid())
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution          String
  course               String
  graduationYear       Int
  skills               String[]
  bio                  String?
  links                String[]
  applications         Application[]
  resumes              Resume[]
  proofs               Proof[]
  challengeSubmissions ChallengeSubmission[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("user_profile")
}

model OrganisationProfile {
  id              String               @id @default(uuid())
  userId          String               @unique
  user            User                 @relation("OrganisationOwner", fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  description     String
  industry        String
  location        String
  website         String?
  /// Written only by application code (`src/lib/profiles.ts`, later admin review), never from form input.
  status          OrganisationStatus   @default(pending)
  /// Last admin decision. Kept as history when an edit sends the profile back to pending.
  reviewedById    String?
  reviewedBy      User?                @relation("OrganisationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  opportunities   Opportunity[]
  members         OrganisationMember[]
  challenges      Challenge[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@map("organisation_profile")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum OpportunityType {
  freelance
  internship
}

enum OpportunityStatus {
  draft
  published
  closed
}

enum WorkMode {
  remote
  onsite
  hybrid
}

enum ExperienceLevel {
  entry
  junior
  mid
  senior
  lead
}

enum PayType {
  paid
  unpaid
}

enum PayPeriod {
  fixed
  month
  hour
}

model Opportunity {
  id                    String                      @id @default(uuid())
  organisationProfileId String
  organisationProfile   OrganisationProfile         @relation(fields: [organisationProfileId], references: [id], onDelete: Cascade)
  type                  OpportunityType
  title                 String
  description           String
  skills                String[]
  workMode              WorkMode
  city                  String?
  payType               PayType
  /// Whole INR; set only when payType is paid.
  payAmount             Int?
  payPeriod             PayPeriod?
  duration              String?
  /// Structured job description: requirements, responsibilities, etc.
  requirements          String?
  /// Experience level (entry, junior, mid, senior, lead).
  experienceLevel       ExperienceLevel?
  /// Optional compensation band (whole INR). Complements payAmount.
  compensationMin       Int?
  compensationMax       Int?
  /// Last day applications are accepted (India time).
  deadline              DateTime?                   @db.Date
  status                OpportunityStatus           @default(draft)
  publishedAt           DateTime?
  closedAt              DateTime?
  /// Last time the AI extracted skills / drafted questions for this listing (`src/lib/listing-assist.ts`).
  aiAssistedAt          DateTime?
  /// all-MiniLM-L6-v2 embedding of the listing text; written with raw SQL (`src/lib/search.ts`).
  embedding             Unsupported("vector(384)")?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  applications          Application[]
  questions             OpportunityQuestion[]
  /// Hiring pipeline, ordered by `position`. Empty = no pipeline (plain accept/reject) (ADR-037).
  stages                PipelineStage[]
  /// Last time the AI suggested a pipeline for this listing (`src/lib/pipeline-assist.ts`).
  pipelineAssistedAt    DateTime?
  /// Optional 30–60 minute task applicants must answer; the answer becomes a Proof (docs/PRODUCT.md Module 4).
  applyTask             String?

  @@index([organisationProfileId])
  @@index([status])
  /// Placeholder so Migrate keeps the HNSW index created by hand in the search_embeddings migration.
  @@index([embedding], map: "opportunity_embedding_idx")
  @@map("opportunity")
}

enum ApplicationStatus {
  submitted
  accepted
  rejected
  withdrawn
}

model Application {
  id                String              @id @default(uuid())
  opportunityId     String
  opportunity       Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userProfileId     String
  userProfile       UserProfile         @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  note              String?
  /// Original file name, shown in the download link. Null when the student applied with proof only (docs/PRODUCT.md Module 4).
  resumeFileName    String?
  /// Generated storage key. Never taken from the client. Snapshot of the resume used; may be shared with a library `Resume`. Null with resumeFileName.
  resumeStorageKey  String?
  /// Library resume chosen for this application. Null for applications made before the library existed, or after that resume was deleted.
  resumeId          String?
  resume            Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status            ApplicationStatus   @default(submitted)
  appliedAt         DateTime            @default(now())
  decidedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  analysis          Analysis?           @relation("ApplicationAnalysis")
  answers           ApplicationAnswer[]
  /// Pipeline stage the candidate is in. Null = "Applied" (not yet in any stage) (ADR-037).
  currentStageId    String?
  currentStage      PipelineStage?      @relation("ApplicationCurrentStage", fields: [currentStageId], references: [id], onDelete: Restrict)
  stageEvents       StageEvent[]
  scheduledEvents   ScheduledEvent[]
  /// Offer (plan 2026-11-12-hiring-and-ai-interview-v2, D2). Set when the owner makes an offer after the last stage.
  offerStatus       OfferStatus?
  offerMessage      String?
  /// Whole INR per month; null = as in the listing / unpaid.
  offerStipendInr   Int?
  offerStartDate    DateTime?           @db.Date
  offeredAt         DateTime?
  offerRespondedAt  DateTime?
  offeredById       String?
  offeredBy         User?               @relation("ApplicationOfferedBy", fields: [offeredById], references: [id], onDelete: SetNull)
  /// Optional reason sent kindly with "Not selected".
  notSelectedReason String?
  /// Proof cards attached when applying (1–3).
  proofs            Proof[]
  interviewSessions InterviewSession[]

  @@unique([opportunityId, userProfileId])
  @@index([opportunityId])
  @@index([userProfileId])
  @@index([resumeId])
  @@index([currentStageId])
  @@map("application")
}

/// Admin-editable prompts for LLM features (resume analysis, JD generation, etc.).
model Prompt {
  id          String   @id @default(uuid())
  /// Stable key identifying the feature, e.g. "resume_analysis".
  key         String   @unique
  name        String /// Human-readable label shown in admin UI.
  content     String /// The full prompt template, may include {{variable}} placeholders.
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("PromptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("prompt")
}

/// AI-generated screening result stored per application: resume fit, answer quality and the combined score.
model Analysis {
  id             String      @id @default(uuid())
  applicationId  String      @unique
  application    Application @relation("ApplicationAnalysis", fields: [applicationId], references: [id], onDelete: Cascade)
  /// Resume fit score 0–100. Null when the resume couldn't be analysed.
  resumeScore    Int?
  summary        String?
  matchedSkills  String[]    @default([])
  missingSkills  String[]    @default([])
  /// Overall answer score 0–100. Null when the listing has no questions or scoring failed.
  answersScore   Int?
  answersSummary String?
  /// Weighted combination computed in code (`combineScores`), never by the LLM.
  overallScore   Int?
  model          String?
  createdAt      DateTime    @default(now())

  @@index([overallScore])
  @@map("analysis")
}

enum ResumeSkillsStatus {
  pending
  done
  failed
  skipped
}

/// A resume in a user's library (max 5). Skills are extracted once, after upload.
model Resume {
  id            String             @id @default(uuid())
  userProfileId String
  userProfile   UserProfile        @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  /// Display name; starts as the uploaded file name and can be renamed.
  fileName      String
  /// Generated storage key. Never taken from the client.
  storageKey    String             @unique
  /// Normalised skills extracted by the LLM (`src/lib/skills.ts`).
  skills        String[]           @default([])
  skillsStatus  ResumeSkillsStatus @default(pending)
  skillsModel   String?
  applications  Application[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userProfileId])
  @@map("resume")
}

enum QuestionSource {
  ai
  organisation
}

/// Screening question on a listing. Locked once the listing has any application.
model OpportunityQuestion {
  id            String              @id @default(uuid())
  opportunityId String
  opportunity   Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  position      Int
  prompt        String
  source        QuestionSource
  answers       ApplicationAnswer[]
  createdAt     DateTime            @default(now())

  @@unique([opportunityId, position])
  @@map("opportunity_question")
}

/// A user's answer to one screening question, with the AI's per-answer score.
model ApplicationAnswer {
  id            String              @id @default(uuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      OpportunityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer        String
  score         Int?
  feedback      String?

  @@unique([applicationId, questionId])
  @@index([questionId])
  @@map("application_answer")
}

enum StageKind {
  interview
  test
  assignment
  other
  /// AI interviewer (chat or voice) that writes a report; never decides (docs/PRODUCT.md Modules 5–6).
  ai_interview
}

/// One step of a listing's hiring pipeline (ADR-037).
model PipelineStage {
  id                String             @id @default(uuid())
  opportunityId     String
  opportunity       Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  position          Int
  name              String
  kind              StageKind
  /// Shown to the candidate (e.g. what to prepare).
  instructions      String?
  /// Optional external link (e.g. a coding test), http/https only.
  externalUrl       String?
  /// Default length when this stage is scheduled.
  durationMinutes   Int?
  source            QuestionSource
  applications      Application[]      @relation("ApplicationCurrentStage")
  stageEvents       StageEvent[]
  scheduledEvents   ScheduledEvent[]
  interviewSessions InterviewSession[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([opportunityId, position])
  @@map("pipeline_stage")
}

enum StageOutcome {
  passed
  failed
  moved
}

/// History of a candidate's pipeline moves. A stage with history can't be deleted.
model StageEvent {
  id            String        @id @default(uuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  outcome       StageOutcome
  actorUserId   String?
  actor         User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime      @default(now())

  @@index([applicationId])
  @@index([stageId])
  @@map("stage_event")
}

enum MemberStatus {
  invited
  active
  deactivated
}

/// A hiring manager of an organisation, from invite to deactivation (ADR-036).
model OrganisationMember {
  id                    String              @id @default(uuid())
  organisationProfileId String
  organisationProfile   OrganisationProfile @relation(fields: [organisationProfileId], references: [id], onDelete: Cascade)
  /// Null until the invite is accepted. One account is a member of at most one organisation.
  userId                String?             @unique
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Lowercased invite address; the accepting account must have this email.
  email                 String
  name                  String
  status                MemberStatus        @default(invited)
  /// SHA-256 (hex) of the invite token. The token itself is never stored. Cleared on accept or revoke.
  inviteTokenHash       String?             @unique
  inviteExpiresAt       DateTime?
  invitedAt             DateTime            @default(now())
  acceptedAt            DateTime?
  deactivatedAt         DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([organisationProfileId, email])
  @@map("organisation_member")
}

enum ScheduleStatus {
  scheduled
  cancelled
  completed
}

enum CalendarSync {
  pending
  synced
  failed
  disabled
}

/// A scheduled interview or test slot for one candidate at one stage.
model ScheduledEvent {
  id              String              @id @default(uuid())
  applicationId   String
  application     Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId         String
  stage           PipelineStage       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  startsAt        DateTime
  durationMinutes Int
  status          ScheduleStatus      @default(scheduled)
  /// Google Calendar event on the platform calendar (ADR-035).
  googleEventId   String?
  /// Google Meet link; interviews only. Null when Calendar is disabled or sync failed.
  meetUrl         String?
  calendarSync    CalendarSync        @default(pending)
  calendarError   String?
  createdById     String?
  createdBy       User?               @relation("ScheduledEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  interviewers    EventInterviewer[]
  feedback        InterviewFeedback[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([applicationId])
  @@index([stageId])
  @@index([startsAt])
  @@map("scheduled_event")
}

/// An interviewer on a scheduled event: an active hiring manager or the organisation owner.
model EventInterviewer {
  scheduledEventId String
  scheduledEvent   ScheduledEvent @relation(fields: [scheduledEventId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([scheduledEventId, userId])
  @@index([userId])
  @@map("event_interviewer")
}

enum Recommendation {
  pass
  fail
  unsure
}

/// One interviewer's feedback on one scheduled event. Never shown to the candidate.
model InterviewFeedback {
  id                String         @id @default(uuid())
  scheduledEventId  String
  scheduledEvent    ScheduledEvent @relation(fields: [scheduledEventId], references: [id], onDelete: Cascade)
  interviewerUserId String
  interviewer       User           @relation(fields: [interviewerUserId], references: [id], onDelete: Cascade)
  rating            Int
  recommendation    Recommendation
  notes             String
  submittedAt       DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([scheduledEventId, interviewerUserId])
  @@map("interview_feedback")
}

// ---------------------------------------------------------------------------
// VenturePath v2 (docs/PRODUCT.md): challenges, proof cards, AI interviewer.
// ---------------------------------------------------------------------------

enum OfferStatus {
  /// Sent; waiting for the student.
  pending
  /// Student accepted → application accepted (Hired).
  accepted
  /// Student declined; the owner can make a new offer or mark not selected.
  declined
  /// Owner withdrew it before the student answered.
  withdrawn
}

enum ChallengeStatus {
  draft
  /// Accepting submissions until the deadline.
  open
  /// Deadline passed or closed early; the organisation is picking winners.
  judging
  /// Winners picked and any money reward marked paid.
  done
}

/// A real business problem posted by an approved organisation. Must carry a reward (money and/or hire).
model Challenge {
  id                    String                @id @default(uuid())
  organisationProfileId String
  organisationProfile   OrganisationProfile   @relation(fields: [organisationProfileId], references: [id], onDelete: Cascade)
  title                 String
  /// The problem in the owner's own words (optionally clarified by AI, then edited by the owner).
  problem               String
  /// What a good solution looks like. Optional.
  goodSolution          String?
  /// Up to 3 judging points. Locked once the first submission arrives.
  criteria              String[]              @default([])
  /// Whole INR. Null = no money reward.
  rewardMoneyInr        Int?
  /// True = the winner is offered an internship/job.
  rewardHire            Boolean               @default(false)
  /// Last moment submissions are accepted.
  deadline              DateTime
  /// Optional attachment from the organisation (generated storage key, never from the client).
  fileKey               String?
  fileName              String?
  status                ChallengeStatus       @default(draft)
  criteriaLockedAt      DateTime?
  publishedAt           DateTime?
  closedAt              DateTime?
  aiAssistedAt          DateTime?
  submissions           ChallengeSubmission[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([organisationProfileId])
  @@index([status, deadline])
  @@map("challenge")
}

enum ChallengePlacement {
  none
  winner
  runner_up
}

enum RewardStatus {
  none
  /// Money paid outside the app (UPI/cash), recorded by the organisation.
  paid
  /// Hire offer sent to the student.
  hire_offered
}

enum AiScoreStatus {
  pending
  done
  failed
  skipped
}

/// One student's solution to one challenge. Editable until the deadline.
model ChallengeSubmission {
  id            String             @id @default(uuid())
  challengeId   String
  challenge     Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userProfileId String
  userProfile   UserProfile        @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  text          String
  link          String?
  fileKey       String?
  fileName      String?
  /// 0–10, computed by AI in the background. Organisation-only.
  aiScore       Int?
  aiScoreStatus AiScoreStatus      @default(pending)
  /// One-line reason for the score.
  aiReason      String?
  /// Short quote from the student's own text backing the score.
  aiQuote       String?
  /// Per judging point: [{ criterion, score (0–5), quote }].
  aiBreakdown   Json?
  aiModel       String?
  /// Submission this one is near-identical to (embedding similarity), if any.
  similarToId   String?
  placement     ChallengePlacement @default(none)
  rewardStatus  RewardStatus       @default(none)
  /// Optional message sent with a hire offer.
  hireMessage   String?
  /// Human who picked the placement / recorded the reward.
  decidedById   String?
  decidedBy     User?              @relation("ChallengeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  proof         Proof?
  submittedAt   DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([challengeId, userProfileId])
  @@index([userProfileId])
  @@map("challenge_submission")
}

enum ProofSource {
  manual
  challenge
  apply_task
}

enum ProofLevel {
  /// Added by the student.
  added
  /// Link responds and AI judged the description plausible for the skills.
  checked
  /// Won or placed in a challenge (set only by challenge judging code).
  verified
}

/// A proof card: something the student made, with what they did. Level is written only by app code.
model Proof {
  id                    String               @id @default(uuid())
  userProfileId         String
  userProfile           UserProfile          @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  title                 String
  whatIDid              String
  link                  String?
  fileKey               String?
  fileName              String?
  skills                String[]             @default([])
  source                ProofSource          @default(manual)
  /// Set when source = challenge.
  challengeSubmissionId String?              @unique
  challengeSubmission   ChallengeSubmission? @relation(fields: [challengeSubmissionId], references: [id], onDelete: Cascade)
  level                 ProofLevel           @default(added)
  /// 0–5 from the AI check.
  aiScore               Int?
  aiScoreStatus         AiScoreStatus        @default(pending)
  aiReason              String?
  checkedAt             DateTime?
  applications          Application[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([userProfileId])
  @@map("proof")
}

enum InterviewMode {
  chat
  voice
}

enum InterviewStatus {
  invited
  in_progress
  completed
  expired
}

enum InterviewRecommendation {
  strong
  maybe
  not_fit
}

enum ReportStatus {
  pending
  done
  failed
}

/// One AI interview for one application at an ai_interview stage. Never decides; only reports.
model InterviewSession {
  id             String                   @id @default(uuid())
  applicationId  String
  application    Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId        String
  stage          PipelineStage            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// SHA-256 (hex) of the invite token. The token itself is never stored.
  tokenHash      String                   @unique
  status         InterviewStatus          @default(invited)
  mode           InterviewMode?
  expiresAt      DateTime
  consentedAt    DateTime?
  /// [{ id, text, kind: "skill"|"proof"|"situation"|"motivation", skill? }] — 6 questions.
  questions      Json
  /// [{ role: "ai"|"student", text, questionId, followUp?: boolean, at }]
  transcript     Json                     @default("[]")
  /// Index of the current question (0-based).
  currentIndex   Int                      @default(0)
  pasteCount     Int                      @default(0)
  tabLeaveCount  Int                      @default(0)
  /// { skills: [{ skill, score 0–5, quote }], strengths[], concerns[], summary }
  report         Json?
  reportStatus   ReportStatus?
  /// Background report attempts so far (retries with backoff before "failed").
  reportAttempts Int                      @default(0)
  /// Computed in code from the report scores, never by the AI.
  recommendation InterviewRecommendation?
  reportModel    String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([applicationId, stageId])
  @@index([applicationId])
  @@map("interview_session")
}
