generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth models follow Better Auth's core schema (generated with `npx auth@1.7.6 generate`).

enum Role {
  student
  msme
  admin
}

model User {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// Null until the user picks a role. Written only by application code, never by auth API input.
  role           Role?
  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?
  msmeProfile    MsmeProfile?    @relation("MsmeOwner")
  msmeReviews    MsmeProfile[]   @relation("MsmeReviewer")
  updatedPrompts Prompt[]        @relation("PromptUpdatedBy")

  @@unique([email])
  @@map("user")
}

enum MsmeStatus {
  pending
  approved
  rejected
}

model StudentProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    String
  course         String
  graduationYear Int
  skills         String[]
  bio            String?
  links          String[]
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("student_profile")
}

model MsmeProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation("MsmeOwner", fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  description     String
  industry        String
  location        String
  website         String?
  /// Written only by application code (`src/lib/profiles.ts`, later admin review), never from form input.
  status          MsmeStatus    @default(pending)
  /// Last admin decision. Kept as history when an edit sends the profile back to pending.
  reviewedById    String?
  reviewedBy      User?         @relation("MsmeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  opportunities   Opportunity[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@map("msme_profile")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum OpportunityType {
  freelance
  internship
}

enum OpportunityStatus {
  draft
  published
  closed
}

enum WorkMode {
  remote
  onsite
  hybrid
}

enum ExperienceLevel {
  entry
  junior
  mid
  senior
  lead
}

enum PayType {
  paid
  unpaid
}

enum PayPeriod {
  fixed
  month
  hour
}

model Opportunity {
  id               String                      @id @default(uuid())
  msmeProfileId    String
  msmeProfile      MsmeProfile                 @relation(fields: [msmeProfileId], references: [id], onDelete: Cascade)
  type             OpportunityType
  title            String
  description      String
  skills           String[]
  workMode         WorkMode
  city             String?
  payType          PayType
  /// Whole INR; set only when payType is paid.
  payAmount        Int?
  payPeriod        PayPeriod?
  duration         String?
  /// Structured job description: requirements, responsibilities, etc.
  requirements     String?
  /// Experience level (entry, junior, mid, senior, lead).
  experienceLevel  ExperienceLevel?
  /// Optional compensation band (whole INR). Complements payAmount.
  compensationMin  Int?
  compensationMax  Int?
  /// Last day applications are accepted (India time).
  deadline         DateTime?                   @db.Date
  status           OpportunityStatus           @default(draft)
  publishedAt      DateTime?
  closedAt         DateTime?
  /// all-MiniLM-L6-v2 embedding of the listing text; written with raw SQL (`src/lib/search.ts`).
  embedding        Unsupported("vector(384)")?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  applications     Application[]

  @@index([msmeProfileId])
  @@index([status])
  /// Placeholder so Migrate keeps the HNSW index created by hand in the search_embeddings migration.
  @@index([embedding], map: "opportunity_embedding_idx")
  @@map("opportunity")
}

enum ApplicationStatus {
  submitted
  accepted
  rejected
  withdrawn
}

model Application {
  id               String            @id @default(uuid())
  opportunityId    String
  opportunity      Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  note             String?
  /// Original file name, shown in the download link.
  resumeFileName   String
  /// Generated storage key. Never taken from the client.
  resumeStorageKey String
  status           ApplicationStatus @default(submitted)
  appliedAt        DateTime          @default(now())
  decidedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  analysis         Analysis?         @relation("ApplicationAnalysis")

  @@unique([opportunityId, studentProfileId])
  @@index([opportunityId])
  @@index([studentProfileId])
  @@map("application")
}

/// Admin-editable prompts for LLM features (resume analysis, JD generation, etc.).
model Prompt {
  id          String   @id @default(uuid())
  /// Stable key identifying the feature, e.g. "resume_analysis".
  key         String   @unique
  name        String   /// Human-readable label shown in admin UI.
  content     String   /// The full prompt template, may include {{variable}} placeholders.
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("PromptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("prompt")
}

/// AI-generated resume analysis stored per application.
model Analysis {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation("ApplicationAnalysis", fields: [applicationId], references: [id], onDelete: Cascade)
  /// Fit score 0–100.
  score         Int
  summary       String?
  matchedSkills String[]    @default([])
  missingSkills String[]    @default([])
  model         String?
  createdAt     DateTime    @default(now())

  @@map("analysis")
}